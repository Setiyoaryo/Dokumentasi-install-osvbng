# Native Linux adaptation example.
# This is not a separately validated milestone yet.
# Lab host:
#   ens4 = ACCESS
#   ens3 = CORE

subscriber-groups:
  groups:
    residential:
      vlan-tpid: dot1q
      ipv4-profile: residential-v4
      vlans:
        - svlan: "100"
          cvlan: any
          interface: loop100
          parent-interface: ens4
          access-types:
            - pppoe
      aaa-policy: pppoe-policy

ipv4-profiles:
  residential-v4:
    gateway: 10.255.0.1
    dns:
      - 8.8.8.8
      - 8.8.4.4
    pools:
      - name: subscriber-pool
        network: 10.255.0.0/16
        priority: 1
    dhcp:
      lease-time: 3600

dhcp:
  provider: local

interfaces:
  loop0:
    description: Control Plane Loopback
    enabled: true
    address:
      ipv4:
        - 10.254.0.1/32

  ens4:
    description: Access Interface
    enabled: true

  ens3:
    description: Core Interface
    enabled: true
    lcp: true
    address:
      ipv4:
        - 10.0.0.2/30

  loop100:
    description: Subscriber Gateway Loopback
    enabled: true
    lcp: true
    address:
      ipv4:
        - 10.255.0.1/32

aaa:
  auth_provider: local
  nas_identifier: osvbng
  policy:
    - name: pppoe-policy
      type: ppp
      format: $agent-remote-id$
      authenticate: true
      max_concurrent_sessions: 1

plugins:
  northbound.api:
    enabled: true
    listeners:
      - address: ":8080"
    uds:
      enabled: true
      path: /run/osvbng/api.sock
      mode: "0660"
      group: osvbng

  subscriber.auth.local:
    allow_all: false
    database_path: /tmp/osvbng.db

logging:
  format: text
  level: info

dataplane:
  lcp-netns: dataplane
